# ============================================
# LABMANAGE WEB - .gitignore
# Solo se sube a GitHub lo necesario para construir y correr el proyecto.
# ============================================

# --- Build output ---
dist/

# --- Astro (tipos generados y caches) ---
.astro/
.astrotypes/

# --- Dependencias ---
node_modules/

# --- Variables de entorno (NUNCA subir secretos/URLs locales) ---
.env
.env.*
!.env.example

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# --- Editores (config personal del desarrollador) ---
.idea/
.vscode/settings.json
*.swp
*.swo

# --- TypeScript / Vite caches ---
*.tsbuildinfo
.vite/

# --- Coverage / tests ---
coverage/

# --- Varios ---
.tmp/
*.tmp