---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "LABMANAGE" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="h-full overflow-hidden bg-slate-200 text-slate-900 antialiased">
    <slot />
  </body>
</html>
