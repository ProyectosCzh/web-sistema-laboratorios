# ============================================
# LABMANAGE WEB - Variables de entorno
# Copia este archivo como .env y completa los valores reales
# ============================================

# --- API REST ---
# URL base de la API vista por el NAVEGADOR (legado FASE 4c: ya sin uso en código,
# se conserva solo como referencia mientras migra todo al BFF).
PUBLIC_API_URL="http://localhost:3001/api"

# --- API REST (privada, server-to-server) ---
# URL que usa el BFF Astro (pages/api) para llamar a la API desde el servidor.
# PRIVADA: sin prefijo PUBLIC_, nunca llega al navegador.
API_URL="http://127.0.0.1:3001/api"

# Cookies Secure: true SOLO detrás de HTTPS/reverse proxy. Default: false (dev local)
WEB_COOKIE_SECURE=false
